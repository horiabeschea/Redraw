# Copy to .env and fill in real keys. .env is gitignored, never committed.
# Plain KEY=value format: loads in bash (set -a; source .env; set +a),
# PowerShell (see README), and dotenv readers.

# Policy, captions, say-it grading, voice transcription. Only needed for live
# calls; without it the lesson runs offline on the cached golden set.
MODEL_API_KEY="paste-key-here"

# Private-mode open-weights backend. Only needed for Private mode.
BASETEN_API_KEY="paste-key-here"

# Optional: meta (default) or baseten.
# REDRAW_BACKEND="meta"
